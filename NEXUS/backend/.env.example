# Example only. Replace YOUR_PASSWORD with your PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexus
SESSION_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
NODE_ENV=development


# First-start owner account bootstrap. Set all three before the first launch.
# The account is created once; changing these values later does not reset its password.
NEXUS_OWNER_EMAIL=owner@example.com
NEXUS_OWNER_USERNAME=nexus_owner
NEXUS_OWNER_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_LONG_PASSWORD

# Upload cap in bytes (default 5 GiB; long videos need substantial disk space)
NEXUS_MAX_UPLOAD_BYTES=5368709120
